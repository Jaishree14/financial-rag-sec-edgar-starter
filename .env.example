# Application
APP_ENV=development
LOG_LEVEL=INFO

# RAG provider: ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1

# Optional OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama
OLLAMA_BASE_URL=http://ollama:11434

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=sec_filings

# SEC
SEC_USER_AGENT=Your Name YourProject your.email@example.com
